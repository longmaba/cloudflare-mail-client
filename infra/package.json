{
  "name": "@doota/infra",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": { "node": ">=24 <25", "pnpm": ">=10 <11" },
  "//": "Alchemy IaC for the three Workers (web, mail-in, mail-jobs). Commands run with cwd = this folder, so alchemy.run.ts references the repo via ../ paths. NODE_OPTIONS strips TS types (needed until node >= 22.18).",
  "scripts": {
    "alchemy": "node run.mjs",
    "plan": "node run.mjs plan",
    "deploy": "node run.mjs deploy",
    "deploy:staging": "node run.mjs deploy --stage staging",
    "destroy": "node run.mjs destroy",
    "check": "node ../apps/web/node_modules/typescript/bin/tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@effect/platform-node": "4.0.0-beta.102",
    "alchemy": "2.0.0-beta.67",
    "effect": "4.0.0-beta.102",
    "@types/node": "26.1.2"
  }
}
